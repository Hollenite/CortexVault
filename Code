#!/usr/bin/env python3
"""
smart_organizer_final.py

Smart local organizer — copies files by extension, classifies images (CLIP),
samples & classifies videos (OpenCV), and classifies JSON files by structure
(SQL-friendly vs NoSQL-friendly). GPU-first. No empty folders are left behind.

Usage:
  python smart_organizer_final.py

Defaults:
  source: downloads
  target: organized_storage

Tune variables in CONFIG section below.
"""
import os
import shutil
import json
import math
import time
from pathlib import Path
from collections import defaultdict, Counter
from typing import Dict, List, Tuple

# ML / vision
import torch
import clip
from PIL import Image, ImageFile
from tqdm import tqdm
ImageFile.LOAD_TRUNCATED_IMAGES = True

# Optional
try:
    import imagehash
except Exception:
    imagehash = None

# Video (optional)
try:
    import cv2
except Exception:
    cv2 = None

# -------------------------
# CONFIG (tweak as needed)
# -------------------------
BATCH_SIZE = 16
TOP_K = 3
CONFIDENCE_THRESHOLD = 0.32
MODEL_NAME = "ViT-B/32"   # change to ViT-L/14 for better accuracy (more memory)
USE_FP16 = True
TTA = True                # test-time flip augmentation
VIDEO_FRAME_INTERVAL = 2  # sample one frame every N seconds
VIDEO_MAX_FRAMES = 16     # max frames to sample per video
SUPPORTED_IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".bmp", ".webp")
SUPPORTED_VIDEO_EXTS = (".mp4", ".mov", ".avi", ".mkv", ".webm")
JSON_EXT = ".json"

# Label map - human-readable labels (you can extend)
LABEL_MAP = {
    "animals": {"children": ["cat", "dog", "horse", "bird", "fish", "elephant"]},
    "humans": {"children": ["person", "man", "woman", "child"]},
    "nature": {"children": ["tree", "mountain", "sunset", "river", "beach"]},
    "vehicles": {"children": ["car", "truck", "bicycle", "motorcycle", "boat", "airplane"]},
    "food": {"children": ["pizza", "burger", "cake", "fruit"]},
    "document": {"children": ["document", "receipt", "screenshot"]},
    "misc": {"children": ["chair", "table", "phone", "laptop", "bag", "watch"]},
}

# -------------------------
# Helpers
# -------------------------
def ensure_dir(p: str):
    Path(p).mkdir(parents=True, exist_ok=True)

def unique_dest_path(dest_dir: str, filename: str) -> str:
    ensure_dir(dest_dir)
    dest = os.path.join(dest_dir, filename)
    if not os.path.exists(dest):
        return dest
    base, ext = os.path.splitext(filename)
    i = 1
    while True:
        cand = os.path.join(dest_dir, f"{base}_{i}{ext}")
        if not os.path.exists(cand):
            return cand
        i += 1

def is_image(fname: str) -> bool:
    return fname.lower().endswith(SUPPORTED_IMAGE_EXTS)

def is_video(fname: str) -> bool:
    return fname.lower().endswith(SUPPORTED_VIDEO_EXTS)

def is_json(fname: str) -> bool:
    return fname.lower().endswith(JSON_EXT)

# -------------------------
# Step 1: copy by extension
# -------------------------
def copy_by_extension(source: str, target: str) -> List[str]:
    ensure_dir(target)
    copied_ext_folders = []
    entries = os.listdir(source)
    if not entries:
        print("⚠ Source folder empty.")
        return []
    for name in entries:
        src = os.path.join(source, name)
        if not os.path.isfile(src):
            continue
        ext = Path(name).suffix.lower().lstrip(".") or "unknown"
        dest_dir = os.path.join(target, ext)
        dest_path = unique_dest_path(dest_dir, name)
        try:
            shutil.copy2(src, dest_path)
            if dest_dir not in copied_ext_folders:
                copied_ext_folders.append(dest_dir)
        except Exception as e:
            print(f"⚠ Failed to copy {src}: {e}")
    print(f"✅ Copied files by extension into: {target}")
    return copied_ext_folders

# -------------------------
# CLIP utilities
# -------------------------
def build_labels(label_map: Dict[str, Dict]) -> Tuple[List[str], Dict[str, str]]:
    labels = []
    child_to_parent = {}
    for parent, info in label_map.items():
        labels.append(parent)
        for child in info.get("children", []):
            labels.append(child)
            child_to_parent[child] = parent
        child_to_parent[parent] = parent
    # unique keep order
    seen = set()
    ordered = []
    for l in labels:
        if l not in seen:
            seen.add(l)
            ordered.append(l)
    return ordered, child_to_parent

def load_clip(model_name: str = MODEL_NAME, use_fp16: bool = USE_FP16):
    device = "cuda" if torch.cuda.is_available() else "cpu"
    model, preprocess = clip.load(model_name, device=device)
    if device == "cuda" and use_fp16:
        try:
            model = model.half()
        except Exception:
            pass
    model.eval()
    return model, preprocess, device

# -------------------------
# Image classification (copy)
# -------------------------
def classify_images_copy(source_folder: str, classified_root: str,
                         label_map: Dict[str, Dict] = LABEL_MAP,
                         batch_size: int = BATCH_SIZE,
                         top_k: int = TOP_K,
                         confidence_threshold: float = CONFIDENCE_THRESHOLD,
                         use_fp16: bool = USE_FP16,
                         tta: bool = TTA):
    labels, child_to_parent = build_labels(label_map)
    model, preprocess, device = load_clip()
    text_tokens = clip.tokenize(labels).to(device)
    with torch.no_grad():
        text_feats = model.encode_text(text_tokens)
        text_feats = text_feats / text_feats.norm(dim=-1, keepdim=True)

    # collect image files under source_folder (including nested)
    image_paths = []
    for root, _, files in os.walk(source_folder):
        for f in files:
            if is_image(f):
                image_paths.append(os.path.join(root, f))
    if not image_paths:
        return {}

    ensure_dir(classified_root)
    created_dirs = set()
    uncategorized_dir = os.path.join(classified_root, "uncategorized")
    ensure_dir(uncategorized_dir)

    # optional duplicate detection
    seen_hashes = set()

    counts = defaultdict(int)
    total = len(image_paths)
    print(f"🔎 Classifying {total} images (device={'cuda' if torch.cuda.is_available() else 'cpu'})...")
    i = 0
    while i < total:
        batch = image_paths[i:i+batch_size]
        tensors = []
        valid_paths = []
        for p in batch:
            try:
                img = Image.open(p).convert("RGB")
            except Exception:
                print(f"⚠ Skipping unreadable image: {p}")
                continue
            # duplicate check
            if imagehash is not None:
                try:
                    ph = str(imagehash.phash(img))
                    if ph in seen_hashes:
                        print(f"⤫ Duplicate detected, skipping: {p}")
                        continue
                    seen_hashes.add(ph)
                except Exception:
                    pass
            if tta:
                try:
                    t1 = preprocess(img)
                    t2 = preprocess(img.transpose(Image.FLIP_LEFT_RIGHT))
                    stacked = torch.stack([t1, t2], dim=0)  # 2 x C x H x W
                    tensors.append(stacked)
                    valid_paths.append(p)
                except Exception:
                    continue
            else:
                try:
                    t = preprocess(img).unsqueeze(0)
                    tensors.append(t)
                    valid_paths.append(p)
                except Exception:
                    continue

        if not tensors:
            i += batch_size
            continue

        batched = torch.cat(tensors, dim=0).to(device)
        if device == "cuda" and use_fp16:
            try:
                batched = batched.half()
            except Exception:
                pass

        with torch.no_grad():
            image_feats = model.encode_image(batched)
            image_feats = image_feats / image_feats.norm(dim=-1, keepdim=True)

        if tta:
            D = image_feats.shape[-1]
            image_feats = image_feats.view(len(valid_paths), -1, D).mean(dim=1)

        sims = (image_feats @ text_feats.T)
        probs = sims.softmax(dim=-1)

        for idx, pth in enumerate(valid_paths):
            prob_row = probs[idx]
            topk = prob_row.topk(top_k)
            topk_scores = topk.values.cpu().tolist()
            topk_idxs = topk.indices.cpu().tolist()
            topk_labels = [labels[j] for j in topk_idxs]

            best_label = topk_labels[0]
            best_score = topk_scores[0]

            if best_score < confidence_threshold:
                dest = uncategorized_dir
                dest_path = unique_dest_path(dest, os.path.basename(pth))
                try:
                    shutil.copy2(pth, dest_path)
                    counts["uncategorized"] += 1
                    created_dirs.add(dest)
                except Exception as e:
                    print(f"⚠ copy failed: {e}")
            else:
                parent = child_to_parent.get(best_label, best_label)
                dest = os.path.join(classified_root, parent, best_label)
                dest_path = unique_dest_path(dest, os.path.basename(pth))
                try:
                    shutil.copy2(pth, dest_path)
                    counts[f"{parent}/{best_label}"] += 1
                    created_dirs.add(dest)
                except Exception as e:
                    print(f"⚠ copy failed: {e}")

            # small log with top-3
            explanation = ", ".join([f"{lab}({scr:.2f})" for lab, scr in zip(topk_labels, topk_scores)])
            print(f"{os.path.basename(pth)} → {best_label} | {explanation}")

        i += batch_size

    # cleanup: remove any created dirs that stayed empty (defensive)
    for d in list(created_dirs):
        if os.path.isdir(d) and not any(os.scandir(d)):
            try:
                os.rmdir(d)
            except Exception:
                pass

    return counts

# -------------------------
# Video classification by frames (copy)
# -------------------------
def sample_video_frames(video_path: str, interval_s: int = VIDEO_FRAME_INTERVAL, max_frames: int = VIDEO_MAX_FRAMES) -> List[Image.Image]:
    frames = []
    if cv2 is None:
        return frames
    try:
        cap = cv2.VideoCapture(video_path)
        if not cap.isOpened():
            return frames
        fps = cap.get(cv2.CAP_PROP_FPS) or 25.0
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
        duration = total_frames / fps if fps else 0
        # sample up to max_frames, spaced by interval_s seconds
        timestamps = []
        if duration <= 0:
            # fallback: sample first N frames
            timestamps = [n / fps for n in range(min(max_frames, total_frames))]
        else:
            t = 0.0
            while t < duration and len(timestamps) < max_frames:
                timestamps.append(t)
                t += interval_s
        for ts in timestamps:
            frame_index = int(ts * fps)
            cap.set(cv2.CAP_PROP_POS_FRAMES, frame_index)
            ret, frame = cap.read()
            if not ret or frame is None:
                continue
            # BGR -> RGB
            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            pil_img = Image.fromarray(frame_rgb)
            frames.append(pil_img)
        cap.release()
    except Exception:
        return frames
    return frames

def classify_video_copy(video_path: str, classified_root: str, label_map = LABEL_MAP):
    # sample frames and classify frames with CLIP (reuse classify_images_copy pipeline in micro-batches)
    frames = sample_video_frames(video_path)
    if not frames:
        return "uncategorized", {}
    # run CLIP on frames directly (small local loop)
    labels, child_to_parent = build_labels(label_map)
    model, preprocess, device = load_clip()
    text_tokens = clip.tokenize(labels).to(device)
    with torch.no_grad():
        text_feats = model.encode_text(text_tokens)
        text_feats = text_feats / text_feats.norm(dim=-1, keepdim=True)

    frame_feats = []
    for img in frames:
        try:
            if TTA:
                t1 = preprocess(img)
                t2 = preprocess(img.transpose(Image.FLIP_LEFT_RIGHT))
                stacked = torch.stack([t1, t2], dim=0).to(device)
                if device == "cuda" and USE_FP16:
                    try:
                        stacked = stacked.half()
                    except Exception:
                        pass
                with torch.no_grad():
                    feat = model.encode_image(stacked)
                    feat = feat / feat.norm(dim=-1, keepdim=True)
                    feat = feat.view(-1, feat.shape[-1]).mean(dim=0)  # average tta
            else:
                t = preprocess(img).unsqueeze(0).to(device)
                if device == "cuda" and USE_FP16:
                    try:
                        t = t.half()
                    except Exception:
                        pass
                with torch.no_grad():
                    feat = model.encode_image(t)
                    feat = feat / feat.norm(dim=-1, keepdim=True)
                    feat = feat.squeeze(0)
            frame_feats.append(feat.cpu())
        except Exception:
            continue
    if not frame_feats:
        return "uncategorized", {}
    # stack and compute similarities
    feats = torch.stack(frame_feats, dim=0).to(device)
    with torch.no_grad():
        sims = feats @ text_feats.T
        probs = sims.softmax(dim=-1)
    avg_probs = probs.mean(dim=0)
    topk = avg_probs.topk(3)
    topk_scores = topk.values.cpu().tolist()
    topk_idxs = topk.indices.cpu().tolist()
    topk_labels = [labels[j] for j in topk_idxs]
    best_label = topk_labels[0]
    best_score = topk_scores[0]

    if best_score < CONFIDENCE_THRESHOLD:
        target_dir = os.path.join(classified_root, "uncategorized")
        ensure_dir(target_dir)
        dest = unique_dest_path(target_dir, os.path.basename(video_path))
        try:
            shutil.copy2(video_path, dest)
        except Exception:
            pass
        return "uncategorized", { "top": list(zip(topk_labels, topk_scores)) }
    else:
        parent = child_to_parent.get(best_label, best_label)
        target_dir = os.path.join(classified_root, parent, best_label)
        dest = unique_dest_path(target_dir, os.path.basename(video_path))
        ensure_dir(target_dir)
        try:
            shutil.copy2(video_path, dest)
        except Exception:
            pass
        return f"{parent}/{best_label}", { "top": list(zip(topk_labels, topk_scores)) }

# -------------------------
# JSON handling
# -------------------------
def analyze_json(path: str) -> str:
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        return "invalid"
    # heuristics: list of dicts with same keys -> sql, else nosql
    if isinstance(data, list) and data and all(isinstance(x, dict) for x in data):
        keys_set = [set(x.keys()) for x in data]
        same = all(k == keys_set[0] for k in keys_set)
        # if all values are primitives (no dict/list) -> SQL
        flat = all(all(not isinstance(v, (dict, list)) for v in x.values()) for x in data)
        return "sql" if same and flat else "nosql"
    if isinstance(data, dict):
        # if top-level has list of dicts under a key -> nosql or sql depending
        for k, v in data.items():
            if isinstance(v, list) and v and all(isinstance(x, dict) for x in v):
                keys = [set(x.keys()) for x in v]
                same = all(k2 == keys[0] for k2 in keys)
                flat = all(all(not isinstance(vv, (dict, list)) for vv in x.values()) for x in v)
                return "sql" if same and flat else "nosql"
        return "nosql"
    return "unknown"

def handle_json_copy(path: str, target_structured_root: str):
    t = analyze_json(path)
    dest_dir = os.path.join(target_structured_root, t)
    ensure_dir(dest_dir)
    dest = unique_dest_path(dest_dir, os.path.basename(path))
    try:
        shutil.copy2(path, dest)
    except Exception as e:
        print(f"⚠ Could not copy JSON {path}: {e}")
    return t

# -------------------------
# Utility: remove empty dirs under target (except 'classified' we created intentionally)
# -------------------------
def remove_empty_dirs(root: str, keep_names: List[str] = None):
    keep_names = set(keep_names or [])
    for dirpath, dirnames, filenames in os.walk(root, topdown=False):
        if os.path.basename(dirpath) in keep_names:
            continue
        if not dirnames and not filenames:
            try:
                os.rmdir(dirpath)
            except Exception:
                pass

# -------------------------
# Main pipeline
# -------------------------
def organize(source="downloads", target="organized_storage"):
    start = time.time()
    if not os.path.isdir(source):
        print(f"❌ Source folder does not exist: {source}")
        return
    print("🚀 Starting organization...")
    ensure_dir(target)

    # 1) Copy by extension
    copied_ext_dirs = copy_by_extension(source, target)

    # prepare classified root and structured root
    classified_root = os.path.join(target, "classified")
    structured_root = os.path.join(target, "structured")
    ensure_dir(classified_root)
    ensure_dir(structured_root)

    overall_counts = defaultdict(int)

    # 2) Image classification: run on ext folders that are images
    for ext in os.listdir(target):
        ext_path = os.path.join(target, ext)
        if not os.path.isdir(ext_path):
            continue
        # handle images
        if ext.lower() in [e.lstrip(".") for e in SUPPORTED_IMAGE_EXTS]:
            counts = classify_images_copy(ext_path, classified_root)
            for k, v in counts.items():
                overall_counts[f"image:{k}"] += v

    # 3) Video classification: copy videos out classified
    if cv2 is not None:
        for ext in os.listdir(target):
            ext_path = os.path.join(target, ext)
            if not os.path.isdir(ext_path):
                continue
            if ext.lower() in [e.lstrip(".") for e in SUPPORTED_VIDEO_EXTS]:
                for fname in os.listdir(ext_path):
                    p = os.path.join(ext_path, fname)
                    if not os.path.isfile(p):
                        continue
                    tag, info = classify_video_copy(p, classified_root)
                    overall_counts[f"video:{tag}"] += 1
                    print(f"{fname} → {tag} | info={info}")
    else:
        print("ℹ OpenCV not installed; skipping video classification. Install opencv-python to enable it.")

    # 4) JSON handling: copy and categorize
    for ext in os.listdir(target):
        ext_path = os.path.join(target, ext)
        if not os.path.isdir(ext_path):
            continue
        if ext.lower() == JSON_EXT.lstrip("."):
            for fname in os.listdir(ext_path):
                p = os.path.join(ext_path, fname)
                if not os.path.isfile(p):
                    continue
                t = handle_json_copy(p, structured_root)
                overall_counts[f"json:{t}"] += 1
                print(f"{fname} → structured/{t}")

    # 5) cleanup empty extension folders (we copied originals, but some ext folders may be empty)
    remove_empty_dirs(target, keep_names={"classified", "structured"})

    # final summary
    print("\n📊 Summary:")
    for k, v in sorted(overall_counts.items(), key=lambda x: -x[1]):
        print(f"  - {k:<40}: {v}")

    elapsed = time.time() - start
    print(f"\n🎉 Done. Results in {target} (took {elapsed:.1f}s)")

# -------------------------
# Run
# -------------------------
if __name__ == "__main__":
    src = input("Enter path to messy folder (default 'downloads'): ").strip() or "downloads"
    tgt = input("Enter path for organized output (default 'organized_storage'): ").strip() or "organized_storage"
    organize(src, tgt)
